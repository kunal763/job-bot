# Job Bot Configuration

# Minimum salary threshold in Lakhs Per Annum (LPA)
MIN_SALARY_LPA=12.0

# Whether to evaluate job listings that do not display salary
ALLOW_UNLISTED_SALARY=false

# LLM Providers (Groq has a free tier: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Alternatively, Google Gemini:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Browser Automation settings
HEADLESS=false
SLOW_MO_MS=250
